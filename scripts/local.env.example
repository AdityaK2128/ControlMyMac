# Copy to scripts/local.env and fill in your own values.
#
#   cp scripts/local.env.example scripts/local.env
#
# Without it the build falls back to the com.example.* identifiers
# below, which are fine for a local ad-hoc build but must be changed to
# something you own before signing for distribution.
#
# Changing the identifier later makes macOS treat it as a brand new app,
# so Screen Recording and Accessibility have to be granted again. Pick
# one and keep it.
CONTROLMYMAC_BUNDLE_ID="com.example.controlmymac.agent"
CONTROLMYMAC_IOS_BUNDLE_ID="com.example.controlmymac.ios"

# Apple Developer Team ID, only needed for signing. Find it at
# developer.apple.com > Membership, or in the OU field of your
# certificate. Leave empty for an ad-hoc local build.
CONTROLMYMAC_TEAM_ID=""
